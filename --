local function addHighlightedTextBox(title, defaultValue, onConfirm)
    local Frame = Instance.new("Frame", Container)
    Frame.Size = UDim2.new(0.92, 0, 0, 36)
    Frame.BackgroundColor3 = ELECTRIC_BLUE
    Frame.ZIndex = 102

    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
    local WhiteGlow = Instance.new("UIStroke", Frame)
    WhiteGlow.Color = GLOW_WHITE
    WhiteGlow.Thickness = 2

    local Label = Instance.new("TextLabel", Frame)
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.Position = UDim2.new(0.04, 0, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Font = Enum.Font.GothamBold
    Label.Text = title:upper()
    Label.TextColor3 = GLOW_WHITE
    Label.TextSize = 8
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local Box = Instance.new("TextBox", Frame)
    Box.Size = UDim2.new(0.4, 0, 0.7, 0)
    Box.Position = UDim2.new(0.56, 0, 0.15, 0)
    Box.BackgroundColor3 = PURE_BLACK
    Box.Font = Enum.Font.GothamBold
    Box.Text = tostring(defaultValue)
    Box.TextColor3 = GLOW_WHITE
    Box.TextSize = 9

    Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
    Box.FocusLost:Connect(function()
        local val = tonumber(Box.Text)
        if val then onConfirm(val) else Box.Text = tostring(defaultValue) end
    end)
end

