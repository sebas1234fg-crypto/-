local function addToggle(funcName, id, callback)
    States[id] = false

    local ItemFrame = Instance.new("Frame", Container)
    ItemFrame.Size = UDim2.new(0.92, 0, 0, 26)
    ItemFrame.BackgroundColor3 = PURE_BLACK
    ItemFrame.ZIndex = 102

    Instance.new("UICorner", ItemFrame).CornerRadius = UDim.new(0, 4)
    local IFStroke = Instance.new("UIStroke", ItemFrame)
    IFStroke.Color = ELECTRIC_BLUE
    IFStroke.Thickness = 1
    table.insert(UIComponentsToUpdate, IFStroke)

    local ItemLabel = Instance.new("TextLabel", ItemFrame)
    ItemLabel.Size = UDim2.new(0.75, 0, 1, 0)
    ItemLabel.Position = UDim2.new(0.03, 0, 0, 0)
    ItemLabel.BackgroundTransparency = 1
    ItemLabel.Font = Enum.Font.GothamMedium
    ItemLabel.Text = funcName
    ItemLabel.TextColor3 = GLOW_WHITE
    ItemLabel.TextSize = 8
    ItemLabel.TextXAlignment = Enum.TextXAlignment.Left

    local SwitchBg = Instance.new("Frame", ItemFrame)
    SwitchBg.Size = UDim2.new(0, 28, 0, 12)
    SwitchBg.Position = UDim2.new(0.96, -30, 0.5, -6)
    SwitchBg.BackgroundColor3 = TOGGLE_OFF

    Instance.new("UICorner", SwitchBg).CornerRadius = UDim.new(1, 0)

    local CircleDot = Instance.new("Frame", SwitchBg)
    CircleDot.Size = UDim2.new(0, 8, 0, 8)
    CircleDot.Position = UDim2.new(0, 2, 0.5, -4)
    CircleDot.BackgroundColor3 = GLOW_WHITE

    Instance.new("UICorner", CircleDot).CornerRadius = UDim.new(1, 0)

    local ClickArea = Instance.new("TextButton", ItemFrame)
    ClickArea.Size = UDim2.new(1, 0, 1, 0)
    ClickArea.BackgroundTransparency = 1
    ClickArea.Text = ""

    ClickArea.MouseButton1Click:Connect(function()
        States[id] = not States[id]
        CircleDot.Position = States[id] and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
        SwitchBg.BackgroundColor3 = States[id] and GREEN_ACTIVE or TOGGLE_OFF
        pcall(callback, States[id])
    end)
end

