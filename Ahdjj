-- Función para realizar Server Hop automático
local function HopServer()
    pcall(function()
        local serversUrl = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            local res = req({Url = serversUrl, Method = "GET"})
            if res and res.Body then
                local body = HttpService:JSONDecode(res.Body)
                if body and body.data then
                    for _, s in ipairs(body.data) do
                        if s.id ~= game.JobId and s.playing < s.maxPlayers then
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                            break
                        end
                    end
                end
            end
        end
    end)
end

-- Bucle principal del ciclo: Play -> Recolectar partida -> Server Hop
task.spawn(function()
    while true do
        task.wait(1.0)
        if farmActive and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- PASO 1: Darle clic al botón Play para iniciar
                ClickPlayByPosition()
                task.wait(2.0)

                local collectedItems = {}
                local itemsFoundInMatch = 0

                -- PASO 2: Recolectar todos los objetos de la partida actual
                local startTime = tick()
                while farmActive and (tick() - startTime < 15) do
                    local foundAny = false
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if not farmActive then break end
                        if obj and obj.Parent and not collectedItems[obj] then
                            local name = string.lower(obj.Name)
                            if string.find(name, "coin") or string.find(name, "moneda") or string.find(name, "pumpkin") or string.find(name, "calabaza") then
                                local targetPart = nil
                                if obj:IsA("BasePart") then
                                    targetPart = obj
                                elseif obj:IsA("Model") then
                                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                end

                                if targetPart then
                                    foundAny = true
                                    itemsFoundInMatch = itemsFoundInMatch + 1
                                    collectedItems[obj] = true
                                    hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.25)
                                end
                            end
                        end
                    end
                    if not foundAny and itemsFoundInMatch > 0 then
                        break
                    end
                    task.wait(0.5)
                end

                -- PASO 3: Al terminar de recolectar, cambiar de servidor
                if farmActive then
                    HopServer()
                    task.wait(5.0)
                end
            end
        end
    end
end)

