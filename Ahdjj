-- 1. SISTEMA DE CONFIGURACIÓN JSON (ESTADO PERSISTENTE)
-- ==========================================================
local configFileName = "Delta/Autoexecute/DuelSuite_AutoFarmConfig.json"
local altConfigFileName = "DuelSuite_AutoFarmConfig.json"

local function SaveConfig(state)
    pcall(function()
        if writefile then
            local data = HttpService:JSONEncode({FarmActive = state})
            writefile(configFileName, data)
            writefile(altConfigFileName, data)
        end
    end)
end

local function LoadConfig()
    local state = true -- Por defecto activado al iniciar si no existe el archivo
    pcall(function()
        local rawData = nil
        if readfile then
            if isfile and isfile(configFileName) then
                rawData = readfile(configFileName)
            elseif isfile and isfile(altConfigFileName) then
                rawData = readfile(altConfigFileName)
            end
        end
        if rawData then
            local decoded = HttpService:JSONDecode(rawData)
            if decoded and decoded.FarmActive ~= nil then
                state = decoded.FarmActive
            end
        end
    end)
    return state
end

