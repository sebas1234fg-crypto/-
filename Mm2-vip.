        notifOverlay.BorderSizePixel = 0
        notifOverlay.ZIndex = 52
        Instance.new("UICorner", notifOverlay).CornerRadius = UDim.new(0, 8)

        local stroke = Instance.new("UIStroke", notifFrame)
        stroke.Color = currentThemeColor
        stroke.Thickness = 1.5
