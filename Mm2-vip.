    ArrowImg.BackgroundTransparency = 1
    ArrowImg.Image = ICONS.ArrowUp
    ArrowImg.ImageColor3 = COLOR_MUTED
    ArrowImg.ScaleType = Enum.ScaleType.Fit
    ArrowImg.ZIndex = 2

    local Container = Instance.new("Frame", CategoryFrame)
    Container.Size = UDim2.new(1, 0, 0, 0)
    Container.Position = UDim2.new(0, 0, 0, 28)
    Container.BackgroundTransparency = 1
    Container.ZIndex = 2

    local ContainerLayout = Instance.new("UIListLayout", Container)
    ContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ContainerLayout.Padding = UDim.new(0, 2)

    local isOpen = true
    local function updateHeight()
        if isOpen then
            Container.Size = UDim2.new(1, 0, 0, ContainerLayout.AbsoluteContentSize.Y)
            CategoryFrame.Size = UDim2.new(1, 0, 0, 28 + ContainerLayout.AbsoluteContentSize.Y)
            ArrowImg.Image = ICONS.ArrowUp
        else
            Container.Size = UDim2.new(1, 0, 0, 0)
            CategoryFrame.Size = UDim2.new(1, 0, 0, 28)
            ArrowImg.Image = ICONS.ArrowDown
        end
    end

    ContainerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if isOpen then updateHeight() end
    end)

    CategoryHeader.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        updateHeight()
    end)

    return Container
end

local function addTab(categoryContainer, name, iconAssetId)
    local PageScroll = Instance.new("ScrollingFrame", PagesContainer)
    PageScroll.Name = name .. "Page"
    PageScroll.Size = UDim2.new(1, 0, 1, 0)
    PageScroll.BackgroundTransparency = 1
    PageScroll.BorderSizePixel = 0
    PageScroll.ScrollBarThickness = 3
    PageScroll.ScrollBarImageColor3 = COLOR_ACCENT
    registerAccent(PageScroll, "ScrollBarImageColor3")
    PageScroll.Visible = false
    PageScroll.ZIndex = 2
    PageScroll.ClipsDescendants = false

    local PageLayout = Instance.new("UIListLayout", PageScroll)
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 6)

    PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        PageScroll.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 15)
    end)

    local TabBtn = Instance.new("TextButton", categoryContainer)
    TabBtn.Size = UDim2.new(1, 0, 0, 26)
    TabBtn.BackgroundTransparency = 1
    TabBtn.Text = "          " .. name
    TabBtn.TextColor3 = COLOR_MUTED
    TabBtn.Font = CURRENT_FONT
    TabBtn.TextSize = 10
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.ZIndex = 2
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

    local TabIcon = nil
    if iconAssetId then
        TabIcon = Instance.new("ImageLabel", TabBtn)
        TabIcon.Size = UDim2.new(0, 14, 0, 14)
        TabIcon.Position = UDim2.new(0, 8, 0.5, -7)
        TabIcon.BackgroundTransparency = 1
        TabIcon.Image = iconAssetId
        TabIcon.ImageColor3 = COLOR_MUTED
        TabIcon.ScaleType = Enum.ScaleType.Fit
        TabIcon.ZIndex = 2
    end

    pages[name] = PageScroll
    tabButtons[name] = {Button = TabBtn, Icon = TabIcon}

    TabBtn.MouseButton1Click:Connect(function()
        if activeTab == name then return end

        for tabName, tbl in pairs(tabButtons) do
            if tabName ~= name then
                TweenService:Create(tbl.Button, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextColor3 = COLOR_MUTED}):Play()
                if tbl.Icon then TweenService:Create(tbl.Icon, TweenInfo.new(0.2), {ImageColor3 = COLOR_MUTED}):Play() end
            end
        end

        TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = COLOR_CARD, BackgroundTransparency = 0.25, TextColor3 = COLOR_TEXT}):Play()
        if TabIcon then TweenService:Create(TabIcon, TweenInfo.new(0.2), {ImageColor3 = COLOR_TEXT}):Play() end

        if activeTab and pages[activeTab] then
            pages[activeTab].Visible = false
        end

        activeTab = name
        PageScroll.Visible = true
    end)

    return PageScroll
end

