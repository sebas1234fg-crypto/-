local function playCustomSound(soundId, volume)
    task.spawn(function()
        pcall(function()
            local s = Instance.new("Sound", SoundService)
            s.SoundId = "rbxassetid://" .. tostring(soundId)
            s.Volume = volume or 1
            s:Play()
            task.delay(3, function() if s then s:Destroy() end end)
        end)
    end)
end

local function formatTime(seconds)
    if not seconds or seconds < 0 then return "00:00:00" end
    local hrs = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

local function getCurrentMapName()
    local mapNames = {}
    for _, child in ipairs(Workspace:GetChildren()) do
        if child.Name ~= "Terrain" and child.Name ~= "Camera" and not Players:GetPlayerFromCharacter(child) then
            if child:FindFirstChild("CoinContainer") or child:FindFirstChild("Spawns") then
                table.insert(mapNames, child.Name)
            end
        end
    end
    if #mapNames > 0 then
        return table.concat(mapNames, ", ")
    end
    return "Lobby / En espera"
end

