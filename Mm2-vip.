    Arrow.Image = ICONS.ArrowDown
    Arrow.ImageColor3 = COLOR_MUTED
    Arrow.ScaleType = Enum.ScaleType.Fit
    Arrow.ZIndex = 11

    local ListContainer = Instance.new("ScrollingFrame", DropdownFrame)
    ListContainer.Size = UDim2.new(0, 130, 0, 0)
    ListContainer.Position = UDim2.new(1, -138, 0.5, 16)
    ListContainer.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
    ListContainer.BackgroundTransparency = 0.15
    ListContainer.BorderSizePixel = 0
    ListContainer.ClipsDescendants = true
    ListContainer.ZIndex = 50
    ListContainer.ScrollBarThickness = 2
    ListContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    ListContainer.Visible = false
    Instance.new("UICorner", ListContainer).CornerRadius = UDim.new(0, 6)

    local listStroke = Instance.new("UIStroke", ListContainer)
    listStroke.Color = currentThemeColor
    listStroke.Thickness = 0
    listStroke.Enabled = false

    local ListLayout = Instance.new("UIListLayout", ListContainer)
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local isOpen = false
    
    local function populateList(currentOptions)
        for _, child in pairs(ListContainer:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
        for _, item in ipairs(currentOptions) do
            local ItemBtn = Instance.new("TextButton", ListContainer)
            ItemBtn.Size = UDim2.new(1, 0, 0, 26)
            ItemBtn.BackgroundTransparency = 1
            ItemBtn.Text = "  " .. item
            ItemBtn.TextColor3 = COLOR_MUTED
            ItemBtn.Font = CURRENT_FONT
            ItemBtn.TextSize = 10
            ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
            ItemBtn.ZIndex = 51
            ItemBtn.MouseButton1Click:Connect(function()
                HeaderBtn.Text = item
                isOpen = false
                listStroke.Enabled = false
                listStroke.Thickness = 0
                TweenService:Create(ListContainer, TweenInfo.new(0.15), {Size = UDim2.new(0, 130, 0, 0)}):Play()
                Arrow.Image = ICONS.ArrowDown
                task.wait(0.15)
                ListContainer.Visible = false
                pcall(callback, item)
            end)
        end
        ListContainer.CanvasSize = UDim2.new(0, 0, 0, #currentOptions * 26)
    end

    HeaderBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        local targetHeight = isOpen and math.min(#options * 26, 120) or 0
        if isOpen then
            ListContainer.Visible = true
            listStroke.Enabled = true
            listStroke.Thickness = 1
            populateList(options)
            TweenService:Create(ListContainer, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 130, 0, targetHeight)}):Play()
        else
            listStroke.Enabled = false
            listStroke.Thickness = 0
            TweenService:Create(ListContainer, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 130, 0, 0)}):Play()
            task.wait(0.15)
            ListContainer.Visible = false
        end
        Arrow.Image = isOpen and ICONS.ArrowUp or ICONS.ArrowDown
    end)

    return function(newOptions)
        options = newOptions
        if isOpen then
            populateList(options)
            local targetHeight = math.min(#options * 26, 120)
            ListContainer.Size = UDim2.new(0, 130, 0, targetHeight)
        end
    end
end

