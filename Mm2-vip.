local function getAimbotTarget()
    if aimbotTargetMode == "Asesino" then
        local m = getMurderer()
        if m and m.Character and m.Character:FindFirstChild("HumanoidRootPart") and m.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            return m.Character.HumanoidRootPart
        end
    elseif aimbotTargetMode == "Sheriff" then
        local s = getSheriff()
        if s and s.Character and s.Character:FindFirstChild("HumanoidRootPart") and s.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            return s.Character.HumanoidRootPart
        end
    elseif aimbotTargetMode == "Jugador Objetivo" and selectedPlayerToTp then
        local target = Players:FindFirstChild(selectedPlayerToTp)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            return target.Character.HumanoidRootPart
        end
    end
    return nil
end

local function dispararSheriffReal()
    local char = LP.Character if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid") if not humanoid or humanoid.Health <= 0 then return end
    local bp = LP:FindFirstChild("Backpack")
    local gun = (bp and bp:FindFirstChild("Gun")) or char:FindFirstChild("Gun") 
    if not gun then 
        showNotification("No tienes la pistola en mano o inventario")
        return 
    end
    if gun.Parent == bp then 
        humanoid:EquipTool(gun) 
        task.wait(0.15) 
    end
    
    local targetPart = getAimbotTarget()
    if targetPart then
        playCustomSound(131350669, 1.2)
        local shootRemote = gun:FindFirstChild("Shoot") or game:GetService("ReplicatedStorage"):FindFirstChild("Shoot", true)
        if shootRemote and shootRemote:IsA("RemoteEvent") then
            shootRemote:FireServer(targetPart.Position)
            playCustomSound(911422137, 1.0)
            showNotification("¡Disparo enviado al objetivo!")
        else
            pcall(function()
                gun:Activate()
                playCustomSound(911422137, 1.0)
                showNotification("Pistola activada")
            end)
        end
    else
        showNotification("No hay objetivo válido seleccionado")
    end
end

local function silentKill(targetPlayer)
    if not LP.Character or not LP.Character:FindFirstChild("Knife") then return end
    local knife = LP.Character.Knife
    local myRoot = LP.Character:FindFirstChild("HumanoidRootPart")
    if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and myRoot then
        local targetRoot = targetPlayer.Character.HumanoidRootPart
        local knifeHandle = knife:FindFirstChild("Handle")
        if knifeHandle and firetouchinterest then
            knife:Activate()
            playCustomSound(911422137, 1.0)
            firetouchinterest(targetRoot, knifeHandle, 0)
            task.wait(0.01)
            firetouchinterest(targetRoot, knifeHandle, 1)
        end
    end
end

local function ejecutarFlingInstantaneo(targetPlayer)
    if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        showNotification("Objetivo no encontrado")
        return
    end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    local targetRoot = targetPlayer.Character.HumanoidRootPart
    local originalPos = root.CFrame

    task.spawn(function()
        local angVel = Instance.new("AngularVelocity")
        angVel.Name = "FlingInstant"
        angVel.MaxTorque = math.huge
        angVel.AngularVelocity = Vector3.new(99999, 99999, 99999)
        angVel.Attachment0 = root:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", root)
        angVel.Parent = root

        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then 
                part.CanCollide = false 
                part.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0, 0, 0, 0)
            end
        end

        local startTime = os.clock()
        while os.clock() - startTime < 0.6 and targetRoot and targetRoot.Parent do
            root.CFrame = targetRoot.CFrame * CFrame.new(math.random(-1,1), math.random(0,2), math.random(-1,1))
            root.AssemblyLinearVelocity = Vector3.new(50000, 50000, 50000)
            RunService.Heartbeat:Wait()
        end

        if root:FindFirstChild("FlingInstant") then root.FlingInstant:Destroy() end
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        root.Velocity = Vector3.new(0, 0, 0)
        root.RotVelocity = Vector3.new(0, 0, 0)

        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.CustomPhysicalProperties = nil
            end
        end

        if hum then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.wait(0.05)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end

        root.CFrame = originalPos + Vector3.new(0, 5, 0)
        showNotification("Fling ejecutado a " .. targetPlayer.Name)
    end)
end

-- Hook para Silent Aim en raycasts (Redirige balas/disparos hacia el asesino)
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if silentAimEnabled and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") then
            local murderer = getMurderer()
            if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                local targetPos = murderer.Character.HumanoidRootPart.Position
                local origin = args[1].Origin
                if typeof(origin) == "Vector3" then
                    local newRay = Ray.new(origin, (targetPos - origin).Unit * 1000)
                    args[1] = newRay
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end)

